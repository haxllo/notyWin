<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NotyWin.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Noty Settings">
    <Grid x:Name="RootGrid" Padding="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="NavBar" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ShortcutsBtn" Grid.Column="0" Content="Shortcuts" Click="OnNavClicked" Tag="shortcuts" Margin="2" />
            <Button x:Name="DeckBtn" Grid.Column="1" Content="Deck" Click="OnNavClicked" Tag="deck" Margin="2" />
            <Button x:Name="NotesBtn" Grid.Column="2" Content="Notes" Click="OnNavClicked" Tag="notes" Margin="2" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <StackPanel x:Name="Content" Spacing="14" />
        </ScrollViewer>
    </Grid>
</Window>
