<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NotyWin.App.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Noty — Library">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Mode picker -->
            <ComboBox x:Name="ModePicker" Grid.Row="0" Margin="12,38,12,8"
                      SelectionChanged="OnModeChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="All Notes" />
                <ComboBoxItem Content="Archive" />
            </ComboBox>

            <!-- Search -->
            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="12,4,12,8"
                     PlaceholderText="Search…" TextChanged="OnSearchChanged" />

            <!-- Note list (built manually in code-behind) -->
            <ScrollViewer x:Name="NoteScroll" Grid.Row="2" Margin="0,4,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NoteList" Spacing="2" />
            </ScrollViewer>

            <!-- Bottom bar -->
            <Grid Grid.Row="3" Padding="12,6,12,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="+ New Note" Click="OnNewNoteClicked" />
                <TextBlock x:Name="CountLabel" Grid.Column="1" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,8,0" Opacity="0.5" FontSize="11" />
                <Button Grid.Column="2" Content="Export…" Click="OnExportClicked" />
            </Grid>
        </Grid>

        <!-- Divider -->
        <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Detail pane -->
        <Grid x:Name="DetailPane" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Detail header -->
            <Grid x:Name="DetailHeader" Grid.Row="0" Padding="16,10,16,10" ColumnSpacing="10"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="DetailColorDot" Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailTitle" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailMeta" FontSize="10.5" Opacity="0.6" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="ArchiveBtn" Content="Archive" Click="OnArchiveClicked" />
                    <Button Content="Delete" Click="OnDeleteClicked" />
                </StackPanel>
            </Grid>

            <!-- Editor -->
            <TextBox x:Name="DetailEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                     BorderThickness="0" Padding="16,8,16,8" FontSize="13"
                     TextChanged="OnDetailTextChanged" />
        </Grid>
    </Grid>
</Window>
