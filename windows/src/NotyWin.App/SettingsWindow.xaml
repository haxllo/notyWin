<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NotyWin.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Noty Settings">
    <Grid Padding="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="Nav" Grid.Row="0"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Top"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Shortcuts" Tag="shortcuts" />
                <NavigationViewItem Content="Deck" Tag="deck" />
                <NavigationViewItem Content="Notes" Tag="notes" />
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <StackPanel x:Name="Content" Spacing="14" />
        </ScrollViewer>
    </Grid>
</Window>
