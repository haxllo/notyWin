<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NotyWin.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotyWin.Geometry\NotyWin.Geometry.csproj" />
    <ProjectReference Include="..\NotyWin.Models\NotyWin.Models.csproj" />
    <ProjectReference Include="..\NotyWin.Storage\NotyWin.Storage.csproj" />
    <ProjectReference Include="..\NotyWin.Rendering\NotyWin.Rendering.csproj" />
  </ItemGroup>
</Project>
