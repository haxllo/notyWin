<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NotyWin.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Noty Settings">
    <StackPanel x:Name="RootPanel" Padding="20" Spacing="10"
                Background="White">
        <TextBlock Text="Noty Settings" FontSize="24" FontWeight="Bold"
                   Foreground="Black" />
        <TextBlock x:Name="StatusText" Text="Loading..." FontSize="14"
                   Foreground="Gray" />
        <StackPanel x:Name="Content" Spacing="10" />
    </StackPanel>
</Window>
